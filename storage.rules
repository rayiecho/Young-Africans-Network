rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // No part of the app currently uses Firebase Storage (uploads go through Cloudinary).
    // Default-deny everything. If a future feature needs Storage, add a specific
    // match block for that exact path instead of loosening this.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
